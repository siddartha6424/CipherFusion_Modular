<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#070B16" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
 <TextView android:id="@+id/backDashboard" android:layout_width="wrap_content" android:layout_height="44dp" android:gravity="center_vertical" android:text="‹  DASHBOARD" android:textColor="#55E7FF" android:textStyle="bold"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="MODULE 03" android:textColor="#4DFF9A" android:textSize="11sp" android:textStyle="bold"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="MEDIA ENCRYPTION" android:textColor="#FFFFFF" android:textSize="25sp" android:textStyle="bold"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Photo • Video • Audio in one isolated module." android:textColor="#8998B7" android:textSize="13sp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal" android:weightSum="3">
  <TextView android:id="@+id/photoTab" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:gravity="center" android:text="PHOTO" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:background="@drawable/bg_nav_selected"/>
  <TextView android:id="@+id/videoTab" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:gravity="center" android:text="VIDEO" android:textColor="#7F8DAA" android:textSize="11sp" android:textStyle="bold"/>
  <TextView android:id="@+id/audioTab" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:gravity="center" android:text="AUDIO" android:textColor="#7F8DAA" android:textSize="11sp" android:textStyle="bold"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" android:weightSum="2">
  <TextView android:id="@+id/mediaEncryptTab" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:text="ENCRYPT" android:textColor="#FFFFFF" android:textStyle="bold" android:background="@drawable/bg_nav_selected"/>
  <TextView android:id="@+id/mediaDecryptTab" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:text="DECRYPT" android:textColor="#7F8DAA" android:textStyle="bold"/>
 </LinearLayout>
 <TextView android:id="@+id/selectMedia" android:layout_width="match_parent" android:layout_height="130dp" android:layout_marginTop="16dp" android:gravity="center" android:text="🖼
SELECT PHOTO" android:textColor="#FFFFFF" android:textSize="15sp" android:background="@drawable/bg_module_card"/>
 <TextView android:id="@+id/mediaName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="No media selected" android:textColor="#AAB8D2" android:textSize="13sp"/>
 <EditText android:id="@+id/mediaKey" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:hint="Secret key" android:textColor="#FFFFFF" android:textColorHint="#586783" android:inputType="textPassword" android:singleLine="true" android:padding="14dp" android:background="@drawable/bg_input"/>
 <TextView android:id="@+id/mediaAction" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:gravity="center" android:text="ENCRYPT PHOTO" android:textColor="#FFFFFF" android:textStyle="bold" android:background="@drawable/bg_button_encrypt"/>
 <TextView android:id="@+id/mediaProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="Ready" android:textColor="#6F7F9D" android:textSize="12sp"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="center" android:text="Encrypted media is stored as a CipherFusion container.
Educational/custom cipher mode — not modern authenticated encryption." android:textColor="#687894" android:textSize="11sp" android:lineSpacingExtra="3dp"/>
</LinearLayout>
</ScrollView>