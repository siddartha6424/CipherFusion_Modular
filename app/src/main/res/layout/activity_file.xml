<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#070B16" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
 <TextView android:id="@+id/backDashboard" android:layout_width="wrap_content" android:layout_height="44dp" android:gravity="center_vertical" android:text="‹  DASHBOARD" android:textColor="#55E7FF" android:textStyle="bold"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="MODULE 02" android:textColor="#C48CFF" android:textSize="11sp" android:textStyle="bold"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="FILE ENCRYPTION" android:textColor="#FFFFFF" android:textSize="25sp" android:textStyle="bold"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Encrypt or decrypt any file locally." android:textColor="#8998B7" android:textSize="13sp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal" android:weightSum="2">
  <TextView android:id="@+id/fileEncryptTab" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:text="ENCRYPT" android:textColor="#FFFFFF" android:textStyle="bold" android:background="@drawable/bg_nav_selected"/>
  <TextView android:id="@+id/fileDecryptTab" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:text="DECRYPT" android:textColor="#7F8DAA" android:textStyle="bold"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/fileEncryptPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp">
  <TextView android:id="@+id/selectFileEncrypt" android:layout_width="match_parent" android:layout_height="110dp" android:gravity="center" android:text="📁
SELECT FILE

Any file type" android:textColor="#FFFFFF" android:textSize="14sp" android:background="@drawable/bg_module_card"/>
  <TextView android:id="@+id/fileEncryptName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="No file selected" android:textColor="#AAB8D2" android:textSize="13sp"/>
  <EditText android:id="@+id/fileEncryptKey" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:hint="Secret key" android:textColor="#FFFFFF" android:textColorHint="#586783" android:inputType="textPassword" android:singleLine="true" android:padding="14dp" android:background="@drawable/bg_input"/>
  <TextView android:id="@+id/fileEncryptButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:gravity="center" android:text="ENCRYPT FILE" android:textColor="#FFFFFF" android:textStyle="bold" android:background="@drawable/bg_button_purple"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/fileDecryptPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="16dp">
  <TextView android:id="@+id/selectFileDecrypt" android:layout_width="match_parent" android:layout_height="110dp" android:gravity="center" android:text="🔐
SELECT .CFFILE

CipherFusion encrypted file" android:textColor="#FFFFFF" android:textSize="14sp" android:background="@drawable/bg_module_card"/>
  <TextView android:id="@+id/fileDecryptName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="No encrypted file selected" android:textColor="#AAB8D2" android:textSize="13sp"/>
  <EditText android:id="@+id/fileDecryptKey" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:hint="Secret key" android:textColor="#FFFFFF" android:textColorHint="#586783" android:inputType="textPassword" android:singleLine="true" android:padding="14dp" android:background="@drawable/bg_input"/>
  <TextView android:id="@+id/fileDecryptButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:gravity="center" android:text="DECRYPT FILE" android:textColor="#FFFFFF" android:textStyle="bold" android:background="@drawable/bg_button_encrypt"/>
 </LinearLayout>
 <TextView android:id="@+id/fileProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="Ready" android:textColor="#6F7F9D" android:textSize="12sp"/>
</LinearLayout>
</ScrollView>