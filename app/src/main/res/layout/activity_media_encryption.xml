<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#070B16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_header">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CIPHERFUSION"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:gravity="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="MEDIA ENCRYPTION"
                android:textColor="#39D9FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="PHOTO • VIDEO • AUDIO"
                android:textColor="#8A9BB8"
                android:textSize="11sp"
                android:gravity="center"/>

        </LinearLayout>


        <!-- MODULE DESCRIPTION -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="MEDIA PROTECTION"
            android:textColor="#39D9FF"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Encrypt photos, videos and audio files using the CipherFusion file engine."
            android:textColor="#B8C5D9"
            android:textSize="14sp"/>


        <!-- SECRET KEY -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="SECRET KEY"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/key"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="Enter encryption key"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:textColorHighlight="#39D9FF"
            android:textSize="15sp"
            android:singleLine="true"
            android:inputType="textPassword"/>


        <!-- SELECTED FILE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="SELECTED MEDIA"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/selectedFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="58dp"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:text="No media selected"
            android:textColor="#8A9BB8"
            android:textSize="14sp"
            android:background="@drawable/bg_output"/>


        <!-- ACTIONS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/encryptButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="ENCRYPT MEDIA"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_encrypt"/>

            <Button
                android:id="@+id/decryptButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="DECRYPT MEDIA"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_purple"/>

        </LinearLayout>


        <!-- PROGRESS -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="STATUS"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="58dp"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:text="Ready"
            android:textColor="#39D9FF"
            android:textSize="14sp"
            android:background="@drawable/bg_output_green"/>


        <!-- SUPPORTED MEDIA -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_card_blue">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SUPPORTED MEDIA"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Photos • Videos • Audio • Documents • Other files"
                android:textColor="#B8C5D9"
                android:textSize="13sp"/>

        </LinearLayout>


        <!-- FOOTER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"
            android:text="CIPHERFUSION • LOCAL PROCESSING"
            android:textColor="#52627A"
            android:textSize="10sp"
            android:gravity="center"/>

    </LinearLayout>

</ScrollView>