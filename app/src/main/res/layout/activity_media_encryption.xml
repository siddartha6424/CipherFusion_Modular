<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070B18"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="22dp"
            android:background="#111B42">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CIPHERFUSION"
                android:textColor="#F5F7FF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:gravity="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="MEDIA ENCRYPTION"
                android:textColor="#18E0FF"
                android:textSize="21sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="PHOTO • VIDEO • AUDIO"
                android:textColor="#9BA8C0"
                android:textSize="15sp"
                android:gravity="center"/>

        </LinearLayout>


        <!-- DESCRIPTION -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="MEDIA PROTECTION"
            android:textColor="#18E0FF"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Encrypt photos, videos and audio files using the CipherFusion file engine."
            android:textColor="#AAB5CA"
            android:textSize="17sp"/>


        <!-- SELECT MEDIA -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:padding="18dp"
            android:orientation="vertical"
            android:background="#11182B">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SELECT MEDIA"
                android:textColor="#18E0FF"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/selectMediaButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:text="📁  SELECT PHOTO / VIDEO / AUDIO"
                android:textColor="#06101C"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#18E0FF"/>

            <TextView
                android:id="@+id/selectedFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="No media selected"
                android:textColor="#E7ECF7"
                android:textSize="16sp"/>

        </LinearLayout>


        <!-- SECRET KEY -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="SECRET KEY"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/key"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:background="#11182B"
            android:hint="Enter encryption key"
            android:textColor="#FFFFFF"
            android:textColorHint="#68758F"
            android:padding="16dp"
            android:singleLine="true"
            android:inputType="textPassword"/>


        <!-- ACTION BUTTONS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/encryptButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:text="🔐 ENCRYPT"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#008ED6"/>

            <Button
                android:id="@+id/decryptButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:text="🔓 DECRYPT"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#7C3CFF"/>

        </LinearLayout>


        <!-- STATUS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:padding="18dp"
            android:orientation="vertical"
            android:background="#10192A">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STATUS"
                android:textColor="#18E0FF"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Ready"
                android:textColor="#DCE6F7"
                android:textSize="17sp"/>

        </LinearLayout>


        <!-- RESULT -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:padding="20dp"
            android:orientation="vertical"
            android:background="#15112D">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RESULT"
                android:textColor="#B66CFF"
                android:textSize="19sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No operation completed yet."
                android:textColor="#E8ECF7"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>


        <!-- SUPPORTED MEDIA -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="24dp"
            android:padding="18dp"
            android:orientation="vertical"
            android:background="#111B42">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SUPPORTED MEDIA"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Photos • Videos • Audio • .cffile encrypted media"
                android:textColor="#AAB5CA"
                android:textSize="16sp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>