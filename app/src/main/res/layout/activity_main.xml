<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#070B16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_header">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CIPHERFUSION"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="SECURE  •  SIMPLE  •  SMART"
                android:textColor="#55E7FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Advanced Unicode Encryption"
                android:textColor="#B9C7E6"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="● ENGINE ONLINE"
                android:textColor="#4DFF9A"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- NAVIGATION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:weightSum="4"
            android:padding="5dp"
            android:background="@drawable/bg_nav">

            <TextView
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="HOME"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_nav_selected" />

            <TextView
                android:id="@+id/navEncrypt"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="ENCRYPT"
                android:textColor="#7F8DAA"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/navDecrypt"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="DECRYPT"
                android:textColor="#7F8DAA"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/navAbout"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="ABOUT"
                android:textColor="#7F8DAA"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- HOME -->
        <LinearLayout
            android:id="@+id/homeScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WELCOME TO CIPHERFUSION"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="A modern encryption workspace designed for text, symbols, emojis and multilingual content."
                android:textColor="#9EACCA"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_card_blue">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="01  UNICODE READY"
                    android:textColor="#55E7FF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Supports English, Hindi, special characters, emoji and other UTF-8 text."
                    android:textColor="#C4D0E8"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_card_purple">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="02  DYNAMIC ENCRYPTION"
                    android:textColor="#C48CFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Uses byte-based Vigenere transformation followed by a key-driven 16 by 16 Polybius square."
                    android:textColor="#C4D0E8"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_card_green">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="03  FAST AND LOCAL"
                    android:textColor="#4DFF9A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Encryption happens directly on the device with no network connection required."
                    android:textColor="#C4D0E8"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/goEncrypt"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="START ENCRYPTING"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_encrypt" />

        </LinearLayout>

        <!-- ENCRYPT -->
        <LinearLayout
            android:id="@+id/encryptScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENCRYPT MESSAGE"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Convert your message into CipherFusion hexadecimal ciphertext."
                android:textColor="#8998B7"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="MESSAGE"
                android:textColor="#55E7FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/encryptMessage"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="7dp"
                android:gravity="top|start"
                android:hint="Type your message here..."
                android:textColorHint="#586783"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:inputType="textMultiLine"
                android:padding="15dp"
                android:background="@drawable/bg_input" />

            <TextView
                android:id="@+id/encryptCounter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:text="0 characters"
                android:textColor="#697895"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="SECRET KEY"
                android:textColor="#C48CFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/encryptKey"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:hint="Enter encryption key"
                android:textColorHint="#586783"
                android:textColor="#FFFFFF"
                android:singleLine="true"
                android:inputType="textPassword"
                android:padding="14dp"
                android:paddingEnd="54dp"
                android:drawableEnd="@drawable/ic_eye_off"
                android:background="@drawable/bg_input" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/random"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="GENERATE KEY"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_purple" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/encrypt"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="ENCRYPT"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_encrypt" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="ENCRYPTED OUTPUT"
                android:textColor="#4DFF9A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/encryptResult"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="7dp"
                android:gravity="top|start"
                android:text="Encrypted output will appear here."
                android:textColor="#9FEAFF"
                android:textSize="14sp"
                android:padding="15dp"
                android:background="@drawable/bg_output" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/copyEncrypt"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="COPY"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_dark" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/clearEncrypt"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="CLEAR"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_dark" />

            </LinearLayout>

            <TextView
                android:id="@+id/encryptTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Execution time: 0.000 ms"
                android:textColor="#6F7F9D"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- DECRYPT -->
        <LinearLayout
            android:id="@+id/decryptScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DECRYPT MESSAGE"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Restore the original UTF-8 message using the correct key."
                android:textColor="#8998B7"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="CIPHERTEXT"
                android:textColor="#C48CFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/decryptMessage"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="7dp"
                android:gravity="top|start"
                android:hint="Paste ciphertext here..."
                android:textColorHint="#586783"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:inputType="textMultiLine"
                android:padding="15dp"
                android:background="@drawable/bg_input" />

            <TextView
                android:id="@+id/decryptCounter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:text="0 characters"
                android:textColor="#697895"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="SECRET KEY"
                android:textColor="#55E7FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/decryptKey"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:hint="Enter decryption key"
                android:textColorHint="#586783"
                android:textColor="#FFFFFF"
                android:singleLine="true"
                android:inputType="textPassword"
                android:padding="14dp"
                android:paddingEnd="54dp"
                android:drawableEnd="@drawable/ic_eye_off"
                android:background="@drawable/bg_input" />

            <TextView
                android:id="@+id/decrypt"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="DECRYPT"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_purple" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="ORIGINAL MESSAGE"
                android:textColor="#4DFF9A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/decryptResult"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="7dp"
                android:gravity="top|start"
                android:text="Decrypted message will appear here."
                android:textColor="#D5FFEA"
                android:textSize="15sp"
                android:padding="15dp"
                android:background="@drawable/bg_output_green" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/copyDecrypt"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="COPY"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_dark" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/clearDecrypt"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="CLEAR"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_dark" />

            </LinearLayout>

            <TextView
                android:id="@+id/decryptTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Execution time: 0.000 ms"
                android:textColor="#6F7F9D"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- ABOUT -->
        <LinearLayout
            android:id="@+id/aboutScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ABOUT CIPHERFUSION"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="CipherFusion is a local Android encryption application focused on a modern interface and Unicode-safe text processing."
                android:textColor="#B6C3DD"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:padding="18dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card_blue">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENCRYPTION ENGINE"
                    android:textColor="#55E7FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="UTF-8 bytes → Vigenere byte transformation → dynamic 16 by 16 Polybius square → hexadecimal coordinates"
                    android:textColor="#C2D0E9"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="18dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card_purple">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUPPORTED CONTENT"
                    android:textColor="#C48CFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="English  •  Hindi  •  Emoji  •  Symbols  •  Unicode"
                    android:textColor="#C2D0E9"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:gravity="center"
                android:text="CIPHERFUSION"
                android:textColor="#55E7FF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="SECURE  •  SIMPLE  •  SMART"
                android:textColor="#687894"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
