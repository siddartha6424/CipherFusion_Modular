<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0D2E"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ========================================================= -->
        <!-- HEADER -->
        <!-- ========================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FILE ENCRYPTION"
            android:textColor="#F5F7FF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:gravity="center"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SECURE ANY FILE • STREAMING ENCRYPTION"
            android:textColor="#18D7E8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:layout_marginBottom="22dp" />


        <!-- ========================================================= -->
        <!-- SELECT FILE CARD -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_blue"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. SELECT FILE"
                android:textColor="#F5F7FF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/selectedFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No file selected"
                android:textColor="#AEB5D9"
                android:textSize="14sp"
                android:padding="12dp"
                android:background="@drawable/bg_input"
                android:ellipsize="middle"
                android:maxLines="2"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/selectFileButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="SELECT FILE"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_encrypt"
                android:stateListAnimator="@null" />

        </LinearLayout>


        <!-- ========================================================= -->
        <!-- ENCRYPTION CARD -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_purple"
            android:padding="18dp"
            android:layout_marginTop="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. ENCRYPT FILE"
                android:textColor="#F5F7FF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SECRET KEY"
                android:textColor="#18D7E8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/encKey"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input"
                android:hint="Enter encryption key"
                android:textColor="#F5F7FF"
                android:textColorHint="#777B9E"
                android:textSize="15sp"
                android:inputType="textPassword"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/encryptButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="ENCRYPT FILE"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_encrypt"
                android:stateListAnimator="@null" />

        </LinearLayout>


        <!-- ========================================================= -->
        <!-- DECRYPTION CARD -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_green"
            android:padding="18dp"
            android:layout_marginTop="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. DECRYPT FILE"
                android:textColor="#F5F7FF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SECRET KEY"
                android:textColor="#18D7E8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/decKey"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input"
                android:hint="Enter decryption key"
                android:textColor="#F5F7FF"
                android:textColorHint="#777B9E"
                android:textSize="15sp"
                android:inputType="textPassword"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/decryptButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="DECRYPT FILE"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_dark"
                android:stateListAnimator="@null" />

        </LinearLayout>


        <!-- ========================================================= -->
        <!-- PROGRESS -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PROCESSING..."
                android:textColor="#18D7E8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progress="0"
                android:visibility="gone"
                style="?android:attr/progressBarStyleHorizontal" />

        </LinearLayout>


        <!-- ========================================================= -->
        <!-- RESULT CARD -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_output_green"
            android:padding="18dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RESULT"
                android:textColor="#F5F7FF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#F5F7FF"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:visibility="gone"
                android:padding="4dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>